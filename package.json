{
  "name": "bureaucat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:deploy": "node scripts/with-database.cjs prisma migrate deploy",
    "dev": "npm run db:deploy && node scripts/with-database.cjs next dev --webpack --hostname 0.0.0.0 --port 3002",
    "build": "node scripts/with-database.cjs next build",
    "start": "npm run db:deploy && node scripts/with-database.cjs next start",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "node scripts/with-database.cjs prisma validate",
    "prisma:generate": "node scripts/with-database.cjs prisma generate",
    "prisma:migrate": "node scripts/with-database.cjs prisma migrate dev"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.19.0",
    "typescript": "^6.0.3"
  }
}
